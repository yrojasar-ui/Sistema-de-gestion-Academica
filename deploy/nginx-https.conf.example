# Plantilla Nginx HTTPS para alojamiento remoto del backend C++ (único escritor).
# Configurar certificados TLS (ej. Let's Encrypt) antes de habilitar.
# Arrancar catalogo_api en 127.0.0.1:8080 con:
#   --origin https://yrojasar-ui.github.io --trusted-proxy 127.0.0.1
# RabbitMQ y biblioteca_worker deben permanecer exclusivamente en red privada/loopback.

limit_req_zone $binary_remote_addr zone=biblioteca_login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=biblioteca_api:10m rate=60r/m;

server {
    listen 443 ssl http2;
    server_name api.biblioteca.example.org;

    ssl_certificate     /etc/letsencrypt/live/api.biblioteca.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.biblioteca.example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    server_tokens off;
    client_max_body_size 1m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    # Bloqueo estricto de la interfaz interna del worker desde Internet.
    location ^~ /api/interno/ {
        return 403 '{"error":"Ruta interna no expuesta"}';
        add_header Content-Type application/json always;
    }

    # Límite más estricto en login (adicional al rate-limit por IP/cuenta de AuthService).
    location = /api/sesion/login {
        limit_req zone=biblioteca_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        limit_req zone=biblioteca_api burst=20 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        proxy_send_timeout 10s;
    }
}
