{
  "name": "biblioteca-academica-catalogo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:docker": "tsc --noEmit && VITE_API_SAME_ORIGIN=true vite build --mode docker",
    "test": "node --test src/*.test.ts",
    "verify:dist": "node verify-dist.mjs",
    "verify:dist:docker": "node verify-dist-docker.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
