# Variables de ejemplo para Docker Compose (NO colocar secretos reales en Git).
# Copiar a .env antes de iniciar: cp .env.example .env

# Puertos locales de demostración (ligados exclusivamente a 127.0.0.1)
WEB_PORT=5173
API_PORT=8080

# Credenciales del broker interno RabbitMQ (cambiar en .env local, nunca publicar)
RABBITMQ_DEFAULT_USER=biblioteca_broker
RABBITMQ_DEFAULT_PASS=CAMBIAR_CONTRASENA_BROKER_LOCAL
RABBITMQ_DEFAULT_VHOST=/

# Parámetros de demostración de la API
DEMO_CHARGE=10000
DEMO_CURRENCY=CRC
SESSION_SECONDS=1800

# Origen CORS adicional (por ejemplo, su instancia local o GitHub Pages)
CORS_ORIGIN=http://127.0.0.1:5173
